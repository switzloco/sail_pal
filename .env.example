# ── Database ──────────────────────────────────────────────────────────────────
# SQLite file path. WAL journal files (.db-wal, .db-shm) are created alongside.
# The directory must exist before starting (start.sh creates it automatically).
DATABASE_URL=sqlite:///./backend/data/vessel.db

# ── Ollama ────────────────────────────────────────────────────────────────────
# URL of the running Ollama daemon.
OLLAMA_HOST=http://localhost:11434

# Primary model for all AI queries.
# Recommended values (check `ollama list` for exact tags on your machine):
#   gemma4:e2b  — Gemma 4 E2B (~8 GB) — fits 8–16 GB RAM laptops
#   gemma4:e4b  — Gemma 4 E4B (~16 GB) — 32 GB+ RAM, stronger medical/engineering reasoning
MODEL_PRIMARY=gemma4:e2b
MODEL_SCALE=gemma4:e4b

# ── Frontend ──────────────────────────────────────────────────────────────────
# Base URL the browser uses to reach the backend.
# Change to the machine's LAN IP if accessing from another device on the network.
# Example: NEXT_PUBLIC_API_BASE=http://192.168.1.42:8000
NEXT_PUBLIC_API_BASE=http://localhost:8000

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins. Add your LAN IP if needed.
CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# ── Cloud simulation mode ─────────────────────────────────────────────────────
# Set CLOUD_MODE=true to skip Ollama entirely and route all AI calls through
# Google AI Studio (gemma-4-26b-a4b-it). Useful for dev and for distributing
# preview builds to testers who haven't installed Ollama.
# A "Cloud preview" banner appears in the UI whenever this is enabled.
# NEVER enable this on a vessel at sea — data leaves the device.
CLOUD_MODE=false
GOOGLE_API_KEY=

# Cloud model to use when CLOUD_MODE=true. Options visible at ai.google.dev:
#   gemma-4-26b-a4b-it  — 4B active / 26B MoE, closest to 12B edge quality
#   gemma-4-31b-it      — strongest; responses will exceed edge-model quality
CLOUD_MODEL=gemma-4-26b-a4b-it

# ── Fleet Mechanic (dockside trace evaluation via Arize) ─────────────────────
# The Fleet Mechanic is the CLOUD-side agent. It ingests the offline medical
# inference traces a vessel captured at sea, replays them into Arize as
# OpenInference spans, runs a Gemini LLM-as-judge hallucination/dosing eval, and
# queues prompt patches to push back to the vessel before it leaves the dock.
#
# Trace CAPTURE always runs (offline, into SQLite). These keys only enable the
# Arize upload + Gemini eval, so leave them blank on the boat. Install the extra
# deps with:  pip install -r backend/requirements-fleet.txt
ARIZE_SPACE_ID=
ARIZE_API_KEY=
ARIZE_PROJECT_NAME=vessel-ops-medical
# The Gemini model used as the judge / patch author (reuses GOOGLE_API_KEY).
FLEET_MECHANIC_MODEL=gemini-2.0-flash

# ── Firebase (Phase 2 — sync when in port) ───────────────────────────────────
# Leave blank for Phase 1. Sync queue accumulates locally and pushes to
# Firestore when internet is available and sync is triggered.
# FIREBASE_PROJECT_ID=
# FIREBASE_CREDENTIALS_JSON=  # path to service account JSON

# ── Web deployment (Cloud Run backend + Firebase Hosting frontend) ───────────
# Cloud Run env vars (set via Cloud Console — never commit the key):
#
#   CLOUD_MODE=true                    ← already set by cloudbuild.yaml
#   GOOGLE_API_KEY=<aistudio.google.com/apikey>
#
# Firebase Hosting build (set at `npm run build` time):
#
#   NEXT_PUBLIC_API_BASE=https://<your-cloud-run-service>.run.app
#   WEB_EXPORT=1
#
# Demo data (MV Resolute) auto-seeds on cold start (Cloud Run is stateless).
