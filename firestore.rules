rules_version = '2';

// Deny all direct client access.
//
// Nothing reaches Firestore from the browser — every read and write goes
// through the Cloud Run API, which uses the Firebase Admin SDK (that bypasses
// these rules by design) and enforces vessel membership itself in
// backend/auth.py.
//
// Keeping authorization in one place means the SQLite and Firestore
// deployments cannot drift on who may read what, and crew medical records are
// never one misread rule away from being world-readable.
//
// If a future version talks to Firestore directly from the client, replace this
// with per-vessel membership rules along the lines of:
//
//   match /vessels/{vesselId} {
//     allow read: if request.auth.uid in resource.data.members;
//     match /{document=**} {
//       allow read: if request.auth.uid in
//         get(/databases/$(database)/documents/vessels/$(vesselId)).data.members;
//     }
//   }
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
